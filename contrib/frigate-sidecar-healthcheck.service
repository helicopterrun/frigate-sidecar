[Unit]
Description=Restart frigate-sidecar after repeated /healthz failures
Documentation=https://github.com/helicopterrun/frigate-sidecar

[Service]
Type=oneshot
# Reads bind_host/bind_port from the sidecar config and restarts the unit
# after 3 consecutive failures (see the script header for why not 1).
Environment=FRIGATE_SIDECAR_CONFIG=/opt/frigate-sidecar/config/sidecar.yml
ExecStart=/usr/local/bin/frigate-sidecar-healthcheck
