[Unit]
Description=Frigate Sidecar — face-crop quality scan (oneshot)
Documentation=https://github.com/helicopterrun/frigate-sidecar
After=network.target

[Service]
Type=oneshot
# Same dedicated user as frigate-sidecar.service: this scan shares that
# service's SQLite DB, so running it as root would leave root-owned WAL
# files behind whenever it fires while the main service is stopped. It
# only reads Frigate's face crops and promotes over Frigate's HTTP API.
User=frigate-sidecar
WorkingDirectory=/opt/frigate-sidecar
Environment="FRIGATE_SIDECAR_CONFIG=/opt/frigate-sidecar/config/sidecar.yml"
ExecStart=/usr/bin/python3 -m frigate_sidecar faces scan
