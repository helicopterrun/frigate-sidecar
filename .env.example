# Copy to .env and edit. Consumed by docker-compose.yml for host paths, and by
# the container for FRIGATE_SIDECAR_* config overrides.

# ---- Compose: host paths -----------------------------------------------------
# Image to run (pin a version instead of latest if you prefer).
#SIDECAR_IMAGE=ghcr.io/helicopterrun/frigate-sidecar:latest
# Frigate's config.yml on this host.
#FRIGATE_CONFIG=/opt/frigate/config.yml
# Directory containing frigate.db (the DIRECTORY -- WAL sidecars are part of the DB).
#FRIGATE_DB_DIR=/opt/frigate/database
# Host-side recordings root (what Frigate's compose mounts at /media/frigate,
# plus /recordings). Mounted read-only at the same path inside the container.
#FRIGATE_RECORDINGS=/opt/frigate/media/recordings
# Writable dir for the sidecar DB + scrub cache. Keep on a DIFFERENT filesystem
# from the recordings. Must be writable by uid 10001.
#SIDECAR_DATA=./data
# Directory holding sidecar.yml (generate one with `fsc init`).
#SIDECAR_CONFIG_DIR=./config

# ---- Sidecar config overrides ------------------------------------------------
# All fields in sidecar.yml can be overridden by env vars prefixed
# FRIGATE_SIDECAR_ and nested with __.
#
# FRIGATE_SIDECAR_FRIGATE__BASE_URL=http://frigate.lan:5000
# FRIGATE_SIDECAR_SIDECAR__BIND_HOST=0.0.0.0
# FRIGATE_SIDECAR_SIDECAR__BIND_PORT=5001
# FRIGATE_SIDECAR_PUSH__MQTT_PASSWORD=secret
# FRIGATE_SIDECAR_LOG_LEVEL=DEBUG
