# Optional environment overrides. All fields in config/sidecar.yml can be
# overridden by env vars prefixed FRIGATE_SIDECAR_ and nested with __.
#
# Example:
# FRIGATE_SIDECAR_FRIGATE__BASE_URL=http://frigate.lan:5000
# FRIGATE_SIDECAR_SIDECAR__BIND_HOST=0.0.0.0
# FRIGATE_SIDECAR_SIDECAR__BIND_PORT=5001
# FRIGATE_SIDECAR_LOG_LEVEL=DEBUG
